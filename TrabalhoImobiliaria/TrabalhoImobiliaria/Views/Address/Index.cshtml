@model List<Modelo.Address>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Endereços</h2>
        <a asp-controller="Address" asp-action="Create" class="btn btn-success">
            <i class="fa fa-plus me-1" aria-hidden="true"></i> Novo endereço
        </a>
    </div>

    @if (Model.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Número</th>
                                <th scope="col">Rua</th>
                                <th scope="col">Cidade</th>
                                <th scope="col">Estado</th>
                                <th scope="col">CEP</th>
                                <th scope="col">País</th>
                                <th scope="col">Tipo</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var address in Model)
                            {
                                <tr>
                                    <td>@address.Id</td>
                                    <td class="text-truncate">@address.Number</td>
                                    <td class="text-truncate">@address.Street</td>
                                    <td class="text-truncate">@address.City</td>
                                    <td class="text-truncate">@address.State</td>
                                    <td class="text-truncate">@address.PostalCode</td>
                                    <td class="text-truncate">@address.Country</td>
                                    <td class="text-truncate">@address.AddressType</td>
                                    <td class="text-center">
                                        <a asp-controller="Address" asp-action="Update" asp-route-id="@address.Id"
                                           class="btn btn-sm btn-primary me-1">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-controller="Address" asp-action="Delete" asp-route-id="@address.Id"
                                           class="btn btn-sm btn-danger">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Não existem endereços cadastrados.
        </div>
    }
</div>
