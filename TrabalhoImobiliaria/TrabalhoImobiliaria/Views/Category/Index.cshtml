@model List<Modelo.Category>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Categorias</h2>
        <a asp-controller="Category" asp-action="Create" class="btn btn-success">
            <i class="fa fa-plus me-1"></i> Nova categoria
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <colgroup>
                            <col style="width: 10%;" />
                            <col style="width: 60%;" />
                            <col style="width: 30%;" />
                        </colgroup>
                        <thead class="table-secondary">
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Nome</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>@category.Id</td>
                                    <td class="text-truncate">@category.Name</td>
                                    <td class="text-center">
                                        <a asp-controller="Category" asp-action="Update" asp-route-id="@category.Id"
                                           class="btn btn-sm btn-primary me-1">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id"
                                           class="btn btn-sm btn-danger">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Não existem categorias cadastradas.
        </div>
    }
</div>
