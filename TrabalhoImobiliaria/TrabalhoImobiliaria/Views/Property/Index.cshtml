@model List<Modelo.Property>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Imóveis</h2>
        <div>
            <a asp-controller="Property" asp-action="Create" class="btn btn-success me-2">
                <i class="fa fa-plus me-1"></i> Novo imóvel
            </a>
            <a asp-controller="Property" asp-action="ExportDelimitatedFile" class="btn btn-secondary">
                <i class="fa fa-file-export me-1"></i> Exportar Delimitado
            </a>
        </div>
    </div>

    @if (Model.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <colgroup>
                            <col style="width: 5%;" />
                            <col style="width: 7%;" />
                            <col style="width: 7%;" />
                            <col style="width: 8%;" />
                            <col style="width: 15%;" />
                            <col style="width: 20%;" />
                            <col style="width: 12%;" />
                            <col style="width: 16%;" />
                            <col style="width: 10%;" />
                        </colgroup>
                        <thead class="table-secondary">
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Quartos</th>
                                <th scope="col">Vagas</th>
                                <th scope="col">Banheiros</th>
                                <th scope="col">Nome</th>
                                <th scope="col">Descrição</th>
                                <th scope="col">Categoria</th>
                                <th scope="col">Endereço</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var property in Model)
                            {
                                <tr>
                                    <td>@property.Id</td>
                                    <td>@property.NroQuartos</td>
                                    <td>@property.NroVagas</td>
                                    <td>@property.NroBanheiros</td>
                                    <td class="text-truncate">@property.Nome</td>
                                    <td class="text-truncate">@property.Descricao</td>
                                    <td class="text-truncate">@property.Categoria?.Name</td>
                                    <td class="text-truncate">@property.Address?.Number</td>
                                    <td class="text-center">
                                        <a asp-controller="Property" asp-action="Update" asp-route-id="@property.Id"
                                           class="btn btn-sm btn-primary me-1">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-controller="Property" asp-action="Delete" asp-route-id="@property.Id"
                                           class="btn btn-sm btn-danger">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Não existem imóveis cadastrados.
        </div>
    }
</div>
