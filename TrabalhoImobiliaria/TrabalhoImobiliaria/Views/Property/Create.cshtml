@model TrabalhoImobiliaria.ViewModels.PropertyViewModel

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header text-center bg-white">
                    <h2 class="mb-0">Cadastro de Imóvel</h2>
                </div>
                <div class="card-body">
                    <form asp-controller="Property" asp-action="Create" id="formProperty" method="post">
                        <div class="mb-3">
                            <label asp-for="@Model.Property!.Id" class="form-label"></label>
                            <input asp-for="@Model.Property!.Id" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.Property!.NroQuartos" class="form-label"></label>
                            <input asp-for="@Model.Property!.NroQuartos" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.Property!.NroVagas" class="form-label"></label>
                            <input asp-for="@Model.Property!.NroVagas" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.Property!.NroBanheiros" class="form-label"></label>
                            <input asp-for="@Model.Property!.NroBanheiros" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.Property!.Nome" class="form-label"></label>
                            <input asp-for="@Model.Property!.Nome" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.Property!.Descricao" class="form-label"></label>
                            <input asp-for="@Model.Property!.Descricao" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.Property!.CategoriaId" class="form-label"></label>
                            <select asp-for="@Model.Property!.CategoriaId" class="form-select">
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.Property!.AddressId" class="form-label"></label>
                            <select asp-for="@Model.Property!.AddressId" class="form-select">
                                @foreach (var c in Model.Addresses!)
                                {
                                    <option value="@c.Id">@c.Number</option>
                                }
                            </select>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Cadastrar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
